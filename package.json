    "express-rate-limit": "^8.5.2",
    "fabric": "^6.6.1",
    "framer-motion": "^12.4.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.9.3",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.7",
    "razorpay": "^2.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
