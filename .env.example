# ============================================================
# AASHA-SM TECH — FREE STACK environment
# All services below have free tiers. Leave blank to run in offline / stub mode.
# ============================================================

# --- Site (Public) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database: MongoDB Atlas Free Tier (https://www.mongodb.com/cloud/atlas) ---
MONGODB_URI=

# --- Auth: NextAuth (v5) + JWT (bcrypt) — Admin Panel ---
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-please-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
JWT_SECRET=change-me-too
# Built-in fallback admin (works without MongoDB):
#   Email:    admin@gmail.com
#   Password: pass12345
# When MONGODB_URI is set, POST /api/admin/seed once to create the hashed admin
# in your database. After that, the fallback can be disabled in src/lib/auth.ts.

# --- Image Storage: Cloudinary Free Plan (https://cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Payments: Razorpay (no monthly fee) — https://razorpay.com ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email: Free options ---
# Option A: Gmail SMTP + Nodemailer (free, use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AASHA-SM TECH <no-reply@aashasmtech.com>
SMTP_TO=adminsmtechsolution@gmail.com
# Option B (alternative): Resend free — https://resend.com
RESEND_API_KEY=

# --- WhatsApp (free wa.me link) ---
NEXT_PUBLIC_WHATSAPP=919529998320

# --- SEO / Analytics (free) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# --- AI Suggestions: Gemini Free Tier (optional) ---
GEMINI_API_KEY=

# --- Backend Server ---
PORT=8787
